[Unit]
Description=Streamlit Boat Control App
After=network.target mavlink-router.service

[Service]
Type=simple
User=master
WorkingDirectory=/home/master/boat_control_web-develop
ExecStart=/home/master/.venv/bin/streamlit run /home/master/boat_control_web-develop/app.py --server.port 8080
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
